# HumanAPI Production Environment Configuration Example
PORT=3000
NODE_ENV=development

# Database Configuration (SQLite local dev / PostgreSQL production)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://postgres:password@localhost:5432/humanapi?schema=public"

# Auth & Secrets
JWT_SECRET=humanapi_jwt_secret_key_production_2026
SESSION_SECRET=humanapi_session_secret_key_2026

# Google Gemini AI API Key (Used for natural language problem analysis & expert accreditation)
GEMINI_API_KEY=your_gemini_api_key_here

# App Public Origin
VITE_APP_URL=http://localhost:3000

# Integrations & Providers
EMAIL_PROVIDER=smtp
EMAIL_API_KEY=your_email_api_key
PAYMENT_PROVIDER_KEYS=mock_gateway_key
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
