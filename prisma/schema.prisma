datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  ACTIVE
  RESTRICTED
  SUSPENDED
  BANNED
  DELETED
}

enum UserRole {
  CLIENT
  EXPERT
  ADMIN
  OWNER
}

enum VerificationStatus {
  APPLIED
  ASSESSMENT_REQUIRED
  ASSESSMENT_IN_PROGRESS
  UNDER_REVIEW
  APPROVED
  SUSPENDED
  BANNED
}

enum CasePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CaseStatus {
  DRAFT
  SUBMITTED
  ANALYZING
  DIAGNOSED
  MATCHING
  MATCHED
  BOOKED
  RESOLVED
  UNRESOLVED
  CLOSED
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
  REFUNDED
}

enum SessionStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
  INTERRUPTED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  HELD
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  passwordHash  String
  firstName     String
  lastName      String
  avatarUrl     String?
  emailVerified Boolean         @default(false)
  status        UserStatus      @default(ACTIVE)
  role          UserRole        @default(CLIENT)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  lastLoginAt   DateTime?

  expertProfile ExpertProfile?
  cases         DeploymentCase[]
  bookings      Booking[]       @relation("ClientBookings")
  feedbackGiven Feedback[]      @relation("ClientFeedback")
  payments      Payment[]       @relation("ClientPayments")
  notifications Notification[]
  auditLogs     AuditLog[]      @relation("ActorAuditLogs")
}

model ExpertProfile {
  id                   String             @id @default(uuid())
  userId               String             @unique
  headline             String
  bio                  String
  yearsExperience      Int
  verificationStatus   VerificationStatus @default(APPLIED)
  accreditationStatus String             @default("PENDING")
  discoverabilityScore Float              @default(80.0)
  rating               Float              @default(5.0)
  reviewCount          Int                @default(0)
  availabilityStatus   String             @default("AVAILABLE")
  pricing5             Int                @default(199)
  pricing10            Int                @default(349)
  pricing15            Int                @default(499)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills       ExpertSkill[]
  availability ExpertAvailability[]
  matches      ExpertMatch[]
  bookings     Booking[]          @relation("ExpertBookings")
  feedback     Feedback[]         @relation("ExpertFeedback")
  payments     Payment[]          @relation("ExpertPayments")
  payouts      Payout[]
}

model Skill {
  id       String        @id @default(uuid())
  name     String        @unique
  category String        @default("DEPLOYMENT")

  experts  ExpertSkill[]
}

model ExpertSkill {
  id              String        @id @default(uuid())
  expertId        String
  skillId         String
  experienceLevel String        @default("EXPERT") // SENIOR, EXPERT, LEAD

  expert          ExpertProfile @relation(fields: [expertId], references: [id], onDelete: Cascade)
  skill           Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([expertId, skillId])
}

model DeploymentProblemCategory {
  id          String                  @id @default(uuid())
  name        String                  @unique
  description String

  problemTypes DeploymentProblemType[]
}

model DeploymentProblemType {
  id                String                    @id @default(uuid())
  categoryId        String
  name              String
  cause             String
  requiredExpertise String                    // JSON array string

  category          DeploymentProblemCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  diagnosisRules    DiagnosisRule[]
  cases             DeploymentCase[]
}

model DiagnosisRule {
  id               String                @id @default(uuid())
  problemTypeId    String
  keywords         String                // JSON array string
  signals          String                // JSON array string
  requiredSkills   String                // JSON array string
  priority         CasePriority          @default(MEDIUM)
  confidenceWeight Float                 @default(0.85)

  problemType      DeploymentProblemType @relation(fields: [problemTypeId], references: [id], onDelete: Cascade)
}

model DeploymentCase {
  id                 String                 @id @default(uuid())
  userId             String
  title              String
  description        String
  repositoryUrl      String
  technology         String
  deploymentPlatform String
  ciCdTool           String
  problemTypeId      String?
  priority           CasePriority           @default(MEDIUM)
  status             CaseStatus             @default(SUBMITTED)
  diagnosis          String?                // JSON string containing diagnosis result
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemType        DeploymentProblemType? @relation(fields: [problemTypeId], references: [id], onDelete: SetNull)
  matches            ExpertMatch[]
  bookings           Booking[]
}

model ExpertMatch {
  id               String         @id @default(uuid())
  deploymentCaseId String
  expertId         String
  score            Float
  matchReasons     String         // JSON array string
  createdAt        DateTime       @default(now())

  deploymentCase   DeploymentCase @relation(fields: [deploymentCaseId], references: [id], onDelete: Cascade)
  expert           ExpertProfile  @relation(fields: [expertId], references: [id], onDelete: Cascade)
}

model ExpertAvailability {
  id          String        @id @default(uuid())
  expertId    String
  dayOfWeek   Int           // 0 = Sun, 1 = Mon ... 6 = Sat
  startTime   String        // e.g. "09:00"
  endTime     String        // e.g. "17:00"
  timezone    String        @default("UTC")
  isAvailable Boolean       @default(true)

  expert      ExpertProfile @relation(fields: [expertId], references: [id], onDelete: Cascade)
}

model Booking {
  id               String        @id @default(uuid())
  clientId         String
  expertId         String
  deploymentCaseId String?
  sessionDuration  Int           // 5, 10, or 15 minutes
  price            Float
  currency         String        @default("INR")
  status           BookingStatus @default(PENDING_PAYMENT)
  scheduledAt      DateTime
  createdAt        DateTime      @default(now())

  client           User           @relation("ClientBookings", fields: [clientId], references: [id], onDelete: Cascade)
  expert           ExpertProfile  @relation("ExpertBookings", fields: [expertId], references: [id], onDelete: Cascade)
  deploymentCase   DeploymentCase?@relation(fields: [deploymentCaseId], references: [id], onDelete: SetNull)
  session          Session?
  payments         Payment[]
}

model Session {
  id        String        @id @default(uuid())
  bookingId String        @unique
  startedAt DateTime?
  endedAt   DateTime?
  status    SessionStatus @default(SCHEDULED)
  roomId    String
  createdAt DateTime      @default(now())

  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  feedback  Feedback?
}

model Feedback {
  id              String        @id @default(uuid())
  sessionId       String        @unique
  clientId        String
  expertId        String
  rating          Int           // 1 to 5
  problemResolved Boolean       @default(true)
  priority        CasePriority  @default(MEDIUM)
  reasons         String?       // JSON array string
  comment         String
  createdAt       DateTime      @default(now())

  session         Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  client          User          @relation("ClientFeedback", fields: [clientId], references: [id], onDelete: Cascade)
  expert          ExpertProfile @relation("ExpertFeedback", fields: [expertId], references: [id], onDelete: Cascade)
}

model Payment {
  id                String        @id @default(uuid())
  bookingId         String
  clientId          String
  expertId          String
  amount            Float
  currency          String        @default("INR")
  provider          String        @default("gateway_mock")
  providerPaymentId String
  status            PaymentStatus @default(PAID)
  platformFee       Float
  expertAmount      Float
  createdAt         DateTime      @default(now())
  paidAt            DateTime?

  booking           Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  client            User          @relation("ClientPayments", fields: [clientId], references: [id], onDelete: Cascade)
  expert            ExpertProfile @relation("ExpertPayments", fields: [expertId], references: [id], onDelete: Cascade)
}

model Payout {
  id             String       @id @default(uuid())
  expertId       String
  amount         Float
  currency       String       @default("INR")
  payoutMethodId String       @default("bank_transfer")
  status         PayoutStatus @default(PENDING)
  requestedAt    DateTime     @default(now())
  processedAt    DateTime?

  expert         ExpertProfile @relation(fields: [expertId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  metadata    String?  // JSON string
  createdAt   DateTime @default(now())

  actor       User?    @relation("ActorAuditLogs", fields: [actorUserId], references: [id], onDelete: SetNull)
}

model DeploymentIncidentExample {
  id                  String @id @default(uuid())
  stage               String
  errorText           String
  context             String
  technology          String
  platform            String
  ciCd                String
  probableProblemType String
  requiredSkills      String // JSON array string
}
